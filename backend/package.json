{
  "name": "souverainrecrut-backend",
  "version": "1.0.0",
  "description": "API REST de la plateforme SouverainRecrut développée avec Node.js, Express, TypeScript et Prisma.",
  "author": "Bootcamp DevOps Conakry 2026",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "lint": "echo \"ESLint sera configuré plus tard\"",
    "format": "echo \"Prettier sera configuré plus tard\"",
    "pretest": "node -e \"require('node:fs').mkdirSync('reports', { recursive: true })\"",
    "test": "c8 node --require tsx/cjs --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml test/api.test.cjs"
  },
  "c8": {
    "all": true,
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.d.ts", "src/docs/**"],
    "reporter": ["lcov", "text-summary"],
    "check-coverage": true,
    "lines": 80
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "devops",
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "rest-api"
  ],
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "prisma": "6.16.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.6.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "c8": "10.1.3",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
